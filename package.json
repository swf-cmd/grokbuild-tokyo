{
  "name": "grokbuild-tokyo",
  "productName": "Grokbuild Tokyo",
  "version": "1.2.4",
  "description": "A Tokyo rainy-night desktop client for the locally installed Grok Build CLI",
  "main": "src/main.cjs",
  "private": true,
  "author": "swf-cmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf-cmd/grokbuild-tokyo.git"
  },
  "homepage": "https://github.com/swf-cmd/grokbuild-tokyo#readme",
  "bugs": {
    "url": "https://github.com/swf-cmd/grokbuild-tokyo/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:security": "node tests/ui-security.cjs",
    "test:accounts": "node scripts/images-accounts-smoke.cjs",
    "test:attachments": "node tests/ui-attachments.cjs",
    "test:i18n": "node tests/i18n-ui.cjs",
    "test:startup": "node tests/startup-ui.cjs",
    "test:time": "node tests/time-ui.cjs",
    "build": "node scripts/package.cjs",
    "build:win": "node scripts/package.cjs --platform win32 --arch x64",
    "build:mac": "node scripts/package.cjs --platform darwin --arch universal",
    "build:mac:arm64": "node scripts/package.cjs --platform darwin --arch arm64",
    "build:mac:x64": "node scripts/package.cjs --platform darwin --arch x64"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0",
    "playwright": "1.63.0",
    "marked": "18.0.11",
    "dompurify": "3.4.15"
  }
}
